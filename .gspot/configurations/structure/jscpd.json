{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;",
        "(?:^|\\n)[\\t ]*(?:from[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*[\\w.]+[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*)?import[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*(?:\\([^;)]*\\)|(?:\\\\\\r?\\n|[^;\\r\\n])*)"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        ".gspot/**",
        ".gspot-copies/**",
        ".editorconfig",
        ".github/workflows/gspot.yml",
        ".markdownlint.jsonc",
        ".prettierignore",
        "prettier.config.mjs",
        "pyrightconfig.json",
        "ruff.toml",
        "**/.venv/**",
        "**/venv/**",
        "**/__pycache__/**",
        "**/.pytest_cache/**",
        "**/.ruff_cache/**",
        "**/.mypy_cache/**",
        "**/coverage/**",
        "**/.env",
        "**/.env.*",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/uv.lock",
        "**/.mise.local.toml",
        "**/*.py[cod]",
        "**/*$py.class",
        "**/*.so",
        "**/*.egg-info/**",
        "**/dist/**",
        "**/build/**",
        "**/.coverage",
        "**/coverage.xml",
        "**/htmlcov/**",
        "**/node_modules/**",
        "dataset_output/**",
        "training_output/**",
        "**/.cache/**",
        "**/*.tar",
        "**/*.wav",
        "**/*.mp3",
        "**/.run/**",
        "**/logs/**",
        "**/*.log",
        "**/.idea/**",
        "**/.vscode/**",
        "**/.cursor/**",
        "**/.claude/**",
        "**/*.swp",
        "**/*.swo",
        "**/*~",
        "**/.DS_Store"
    ]
}
