# Hugging Face token: write access to publish, read access to train on a private dataset.
HF_TOKEN=
# Rank of this training process on its host. torchrun sets it; leave it empty for one GPU.
LOCAL_RANK=
# Bearer token that the dataset command sends to the Orpheus server.
ORPHEUS_API_KEY=
# Orpheus server address: an http, https, ws, or wss URL, or host:port.
ORPHEUS_SERVER_URL=
# Number of training processes. torchrun sets it; leave it empty for one GPU.
WORLD_SIZE=
